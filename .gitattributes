# =============================================================================
# Deploy-Drivers-For-WindowsServer .gitattributes
# =============================================================================
# Normalise line endings to keep diffs sane across Windows/Linux/macOS.

# Default: auto-detect text files, normalise to LF in repo
* text=auto eol=lf

# PowerShell scripts MUST keep CRLF because Windows PowerShell on some legacy
# platforms (particularly when launched via cmd /c) chokes on bare LF.
# working-tree-encoding=UTF-8 tells git the working-tree files are stored as
# UTF-8 (with BOM, see file-encoding section in README.md). This protects
# against accidental Shift-JIS / UTF-16 re-encoding when the file is checked
# out on a ja-JP Windows host that has 'core.autocrlf' or third-party
# editor hooks active.
*.ps1   text working-tree-encoding=UTF-8 eol=crlf

# Batch files are stored VERBATIM, not normalised. cmd.exe is the interpreter
# of last resort in the Windows Recovery Environment and mis-parses a script
# whose lines end in bare LF, so the line endings here are a functional
# requirement rather than a style preference.
#
# 'text eol=crlf' would be the obvious choice and is wrong for this case: it
# stores the blob LF-normalised and converts on checkout, which means the
# bytes are only correct when the consumer's git does the conversion. A .cmd
# reaches the recovery environment by being copied to a USB stick, sometimes
# from a downloaded archive that never ran a checkout filter. '-text' keeps
# CRLF in the blob itself so every path to the file yields the same bytes.
#
# No working-tree-encoding either: a .cmd must stay plain ASCII with no BOM,
# because cmd.exe treats a BOM as part of the first command.
*.cmd   -text
*.psm1  text working-tree-encoding=UTF-8 eol=crlf
*.psd1  text working-tree-encoding=UTF-8 eol=crlf

# Markdown / docs / source: LF
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf

# Binary blobs: never modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.cat   binary
*.pfx   binary
*.cer   binary

# Generated research dataset is stored VERBATIM, not normalised.
# tools/amd-chipset-driver-research/public/** is a machine-generated evidence
# surface whose publication-manifest.json records the SHA-256 of every payload
# file. EOL normalisation would rewrite those bytes at commit time and the
# recorded hashes would no longer verify against a fresh clone, destroying the
# artifact's self-verification. '-text' keeps the generator's bytes exactly as
# they were audited. Same reasoning as the *.cmd rule above.
tools/amd-chipset-driver-research/public/**  -text

# GitHub language detection: count .ps1 lines toward "PowerShell"
*.ps1 linguist-language=PowerShell

# Don't count generated docs toward language stats
TESTING.md  linguist-documentation
README.md   linguist-documentation
README.ja.md linguist-documentation
CONTRIBUTING.md linguist-documentation
