{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/amd-npu-driver-research/publication-manifest.schema.json",
  "title":"AMD NPU research publication manifest",
  "type":"object",
  "required":["SchemaVersion","ToolVersion","HandEdited","Source","GeneratedFiles"],
