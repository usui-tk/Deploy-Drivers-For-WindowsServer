{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usui-tk/Deploy-Drivers-For-WindowsServer/tools/amd-npu-driver-research/schemas/source-data/architecture-convergence-contract.source.schema.json",
  "title": "AMD NPU reviewed source data: architecture-convergence-contract.json",
  "description": "Schema for Git-tracked reviewed source data. This is distinct from the PascalCase generated public schema.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "amd-npu-architecture-convergence-contract/1.0"
    },
    "reviewedAtUtc": {
      "type": "string"
    },
    "normalization": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "genericKernelFunctionCount": {
      "type": "integer"
    },
    "genericKernelFunctions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ]
      }
    },
    "forbiddenLegacyInfrastructureFunctions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredNpuAdapterFunctions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "convergenceRules": {
      "type": "object",
      "properties": {
        "stageRunner": {
          "type": "string"
        },
        "evidenceLifecycle": {
          "type": "string"
        },
        "publicationMechanics": {
          "type": "string"
        },
        "acquisition": {
          "type": "string"
        },
        "extraction": {
          "type": "string"
        },
        "discoverMetadataInspect": {
          "type": "string"
        },
        "emergencyEvidence": {
          "type": "string"
        },
        "canonicalJson": {
          "type": "string"
        },
        "ordering": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stageRunner",
        "evidenceLifecycle",
        "publicationMechanics",
        "acquisition",
        "extraction",
        "discoverMetadataInspect",
        "emergencyEvidence",
        "canonicalJson",
        "ordering"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewedAtUtc",
    "normalization",
    "architecture",
    "genericKernelFunctionCount",
    "genericKernelFunctions",
    "forbiddenLegacyInfrastructureFunctions",
    "requiredNpuAdapterFunctions",
    "convergenceRules"
  ]
}
