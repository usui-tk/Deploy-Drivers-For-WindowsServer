{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/amd-npu-driver-research/published-driver-artifacts.schema.json",
  "title": "AMD NPU Published Driver Artifact Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewedAtUtc",
    "discovery",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "amd-npu-published-driver-artifacts/1.1"
    },
    "reviewedAtUtc": {
      "type": "string",
      "minLength": 1
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentationUrl",
        "policy"
      ],
      "properties": {
        "documentationUrl": {
          "type": "string",
          "format": "uri"
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "fileName",
          "artifactFormat",
          "downloadUrl",
          "expectedSha256",
          "expectedSizeBytes",
          "publishedDriverLabel",
          "sourceStatus",
          "defaultAcquire"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "fileName": {
            "type": "string",
            "pattern": "\\.(zip|exe|msi|cab|7z)$"
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          },
          "expectedSha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedSizeBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "publishedDriverLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceStatus": {
            "type": "string",
            "minLength": 1
          },
          "defaultAcquire": {
            "type": "boolean"
          },
          "artifactFormat": {
            "enum": [
              "zip",
              "exe",
              "msi",
              "cab",
              "7z"
            ]
          }
        }
      }
    }
  }
}
