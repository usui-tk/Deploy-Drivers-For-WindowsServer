{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/amd-npu-driver-research/processor-catalog.schema.json",
  "title": "AMD NPU reviewed processor catalog",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolVersion",
    "HandEdited",
    "ReviewedAt",
    "CatalogCompleteness",
    "UnknownSkuPolicy",
    "Normalization",
    "Sources",
    "Processors",
    "CanonicalNameSelfTests"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "1.3"
    },
    "ToolVersion": {
      "type": "string"
    },
    "HandEdited": {
      "const": false
    },
    "UnknownSkuPolicy": {
      "const": "ReviewRequired"
    },
    "Processors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "processorId",
          "canonicalName",
          "matchRegex",
          "series",
          "codename",
          "npuIdentityId",
          "expectedDeviceIds",
          "npuTops",
          "sourceIds",
          "npuAvailability",
          "npuEvidence",
          "productIdTray"
        ],
        "properties": {
          "npuAvailability": {
            "enum": [
              "AvailablePublished",
              "NotAvailablePublished",
              "NoPublishedNpuCapability",
              "Unknown"
            ]
          },
          "npuIdentityId": {
            "type": [
              "string",
              "null"
            ]
          },
          "expectedDeviceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "npuTops": {
            "type": [
              "number",
              "null"
            ]
          },
          "productIdTray": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observedCpuIdentity": {
            "type": [
              "object",
              "null"
            ]
          },
          "observedNpuIdentity": {
            "type": [
              "object",
              "null"
            ]
          },
          "observedClientRuntime": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "CanonicalNameSelfTests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ProcessorId",
          "CanonicalName",
          "Status",
          "ResolvedProcessorId"
        ],
        "properties": {
          "Status": {
            "const": "ExactCatalogMatch"
          }
        }
      }
    }
  }
}
