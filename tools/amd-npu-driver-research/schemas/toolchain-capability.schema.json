{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amd-npu-driver-research:toolchain-capability-summary:1.1",
  "title": "AMD NPU Driver Research Toolchain Capability Summary",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolkitVersion",
    "EvidenceScope",
    "Status",
    "Tools",
    "MutationPerformed",
    "LocalizationContext",
    "ResultClassificationContract"
  ],
  "properties": {
    "SchemaVersion": { "const": "amd-driver-toolchain-capability-summary/1.1" },
    "ToolkitVersion": { "type": "string" },
    "CollectedAtUtc": { "type": ["string", "null"] },
    "EvidenceScope": { "const": "WindowsNativeToolchain" },
    "Status": { "type": "string" },
    "ExecutionClass": { "type": "string" },
    "Tools": { "type": "array", "items": { "type": "object" } },
    "VerificationProfileContract": { "type": "object" },
    "MutationPerformed": { "const": false },
    "LocalizationContext": { "type": "object" },
    "ResultClassificationContract": { "type": "object" }
  },
  "additionalProperties": true
}
