{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usui-tk/Deploy-Drivers-For-WindowsServer/tools/amd-npu-driver-research/tools/schemas/npu-hardware-selection-input.schema.json",
  "title": "AMD NPU collector hardware selection input observation",
  "type": "object",
  "required": [
    "SchemaVersion",
    "SchemaReference",
    "Tool",
    "CollectedAtUtc",
    "Host",
    "Enumeration",
    "CandidateDeviceCount",
    "ObservationStatus",
    "Candidates",
    "SelectionBoundary",
    "ServerPositiveCase",
    "Privacy"
  ],
  "properties": {
    "SchemaVersion": { "const": "1.0.0" },
    "SchemaReference": { "const": "tools/schemas/npu-hardware-selection-input.schema.json" },
    "Tool": {
      "type": "object",
      "required": ["Name", "Version"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "Version": { "const": "1.3.0" }
      },
      "additionalProperties": false
    },
    "CollectedAtUtc": { "type": "string", "format": "date-time" },
    "Host": {
      "type": "object",
      "required": ["ExecutionClass", "ProductType", "Caption", "BuildNumber", "PowerShellVersion", "PowerShellEdition", "IsAdministrator"],
      "properties": {
        "ExecutionClass": { "enum": ["WindowsClient", "WindowsServer", "UnknownWindows"] },
        "ProductType": { "type": "integer" },
        "ServerRole": { "type": ["string", "null"] },
        "Caption": { "type": "string" },
        "Version": { "type": "string" },
        "BuildNumber": { "type": "string" },
        "OSArchitecture": { "type": "string" },
        "PowerShellVersion": { "type": "string" },
        "PowerShellEdition": { "type": "string" },
        "IsAdministrator": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "Enumeration": {
      "type": "object",
      "required": ["Status", "InputSource", "LocalEnumerationPerformed", "ManualOverrideUsed", "ScannedPnpEntityCount", "ScannedAmdPciEntityCount"],
      "properties": {
        "Status": { "enum": ["Complete", "Partial", "Failed"] },
        "Error": { "type": ["string", "null"] },
        "InputSource": { "const": "LocalWindowsPnP" },
        "LocalEnumerationPerformed": { "const": true },
        "ManualOverrideUsed": { "const": false },
        "ScannedPnpEntityCount": { "type": "integer", "minimum": 0 },
        "ScannedAmdPciEntityCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "CandidateDeviceCount": { "type": "integer", "minimum": 0 },
    "ObservationStatus": { "enum": ["NoNpuObserved", "NpuCandidateObserved", "IncompleteEvidence"] },
    "Candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["InstanceId", "ConfigManagerErrorCode", "HardwareIds", "CompatibleIds", "IdentitySet", "CandidateReasons", "PropertyCollection", "RuntimeDriverObservation"],
        "properties": {
          "InstanceId": { "type": "string", "minLength": 1 },
          "Name": { "type": "string" },
          "Description": { "type": "string" },
          "PnpClass": { "type": "string" },
          "Service": { "type": "string" },
          "Status": { "type": "string" },
          "ConfigManagerErrorCode": { "type": "string", "minLength": 1 },
          "HardwareIds": { "type": "array", "items": { "type": "string" } },
          "CompatibleIds": { "type": "array", "items": { "type": "string" } },
          "IdentitySet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "PciIdentity": { "type": "object" },
          "CandidateReasons": { "type": "array", "items": { "type": "string" } },
          "PropertyCollection": {
            "type": "object",
            "required": ["Status", "Error"],
            "properties": {
              "Status": { "enum": ["Complete", "Unavailable", "Failed"] },
              "Error": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "RuntimeDriverObservation": {
            "type": "object",
            "required": ["Status", "SignatureOrSignerIsSelectionInput", "SupportsCustomBuiltOrSelfSignedServerDriverObservation"],
            "properties": {
              "Status": { "enum": ["Observed", "NotObserved", "CollectionFailed"] },
              "InstalledDriver": { "type": ["object", "null"] },
              "DriverInfEvidence": { "type": ["object", "null"] },
              "ServiceBinaryEvidence": { "type": ["object", "null"] },
              "SignatureOrSignerIsSelectionInput": { "const": false },
              "SupportsCustomBuiltOrSelfSignedServerDriverObservation": { "const": true }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "SelectionBoundary": {
      "type": "object",
      "required": ["DriverTrackSelectionPerformed", "DriverTrackDecision", "CpuSkuUsedForSelection", "CpuNpuCombinationUsedForSelection", "FirmwareRevisionUsedForSelection", "XrtIdentityUsedForSelection", "Automatic280FallbackAllowed"],
      "properties": {
        "DriverTrackSelectionPerformed": { "const": false },
        "DriverTrackDecision": { "const": "NotPerformedByCollector" },
        "CpuSkuUsedForSelection": { "const": false },
        "CpuNpuCombinationUsedForSelection": { "const": false },
        "FirmwareRevisionUsedForSelection": { "const": false },
        "XrtIdentityUsedForSelection": { "const": false },
        "Automatic280FallbackAllowed": { "const": false },
        "MachineAuthorityExpectedDownstream": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ServerPositiveCase": {
      "type": "object",
      "required": ["Supported", "ObservationStatus", "RuntimeEvidenceMayContainCustomBuiltOrSelfSignedDriver", "AmdPublishedPayloadExactMatchRequired", "XrtRuntimeRequired"],
      "properties": {
        "Supported": { "const": true },
        "ObservationStatus": { "enum": ["NotApplicable", "IncompleteEvidence", "NoNpuObserved", "NpuRuntimeObservedHealthy", "NpuCandidateObservedNeedsReview"] },
        "Definition": { "type": "string" },
        "RuntimeEvidenceMayContainCustomBuiltOrSelfSignedDriver": { "const": true },
        "AmdPublishedPayloadExactMatchRequired": { "const": false },
        "XrtRuntimeRequired": { "const": false },
        "ImportantNote": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Privacy": { "type": "object" }
  },
  "additionalProperties": false
}
