{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amd-chipset-driver-research:release:1.0",
  "title": "AMD Chipset Release Discovery",
  "type": "object",
  "required": [
    "SchemaVersion",
    "Releases"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "1.0"
    },
    "ToolkitVersion": {
      "type": "string"
    },
    "GeneratedAtUtc": {
      "type": "string"
    },
    "Completeness": {
      "type": "string"
    },
    "ReleaseCount": {
      "type": "integer",
      "minimum": 0
    },
    "Releases": {
      "type": "array"
    }
  }
}