{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amd-driver-research:signature-analysis:1.0",
  "title": "AMD Driver Static Signature Analysis",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolkitVersion",
    "GeneratedAtUtc",
    "EvidenceScope",
    "Releases"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "amd-driver-signature-analysis/1.0"
    },
    "ToolkitVersion": {
      "type": "string"
    },
    "GeneratedAtUtc": {
      "type": "string"
    },
    "EvidenceScope": {
      "const": "Static"
    },
    "ReleaseSelectionPolicy": {
      "type": "string",
      "enum": ["OnlySelectedRelease", "NewestSelectedReleaseOnly"]
    },
    "CandidateReleaseCount": {
      "type": "integer",
      "minimum": 1
    },
    "AnalyzedReleaseVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string" }
    },
    "AnalysisBoundary": {
      "type": "string"
    },
    "Releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/releaseSignatureAnalysis"
      }
    }
  },
  "$defs": {
    "releaseSignatureAnalysis": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "EvidenceScope",
        "ReleaseVersion",
        "Status",
        "FileCount",
        "Files",
        "Certificates"
      ],
      "properties": {
        "SchemaVersion": {
          "const": "amd-driver-signature-analysis/1.0"
        },
        "EvidenceScope": {
          "const": "Static"
        },
        "ReleaseVersion": {
          "type": "string"
        },
        "Status": {
          "type": "string"
        },
        "FileCount": {
          "type": "integer",
          "minimum": 0
        },
        "UniqueCertificateCount": {
          "type": "integer",
          "minimum": 0
        },
        "Files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "Certificates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "required": [
        "FileId",
        "FileName",
        "FileType",
        "Size",
        "Sha256",
        "Occurrences",
        "EmbeddedSignatureState",
        "Envelopes"
      ],
      "properties": {
        "FileId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "FileName": {
          "type": "string"
        },
        "FileType": {
          "enum": [
            "KernelBinary",
            "Catalog",
            "Library",
            "Executable",
            "PortableExecutable",
            "CmsSignedData",
            "CertificateFile",
            "Other"
          ]
        },
        "Extension": {
          "type": "string"
        },
        "Size": {
          "type": "integer",
          "minimum": 0
        },
        "Sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "Occurrences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "EmbeddedSignatureState": {
          "type": "string"
        },
        "PeCertificateTableStatus": {
          "type": "string"
        },
        "PeCertificateEntries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "Envelopes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ObservedFileNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "DetectedFormat": {
          "enum": [
            "PE",
            "Catalog",
            "CMS",
            "X509Certificate",
            "Other"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
