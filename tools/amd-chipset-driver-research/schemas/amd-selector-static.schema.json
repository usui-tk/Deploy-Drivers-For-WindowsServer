{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amd-chipset-driver-research:amd-selector-static:1.2",
  "title": "AMD Chipset Static Selector Analysis (Qt compiled-selector evidence)",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolkitVersion",
    "Releases"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "amd-chipset-selector-static/1.2"
    },
    "ToolkitVersion": {
      "type": "string"
    },
    "GeneratedAtUtc": {
      "type": "string"
    },
    "AnalysisBoundary": {
      "type": "string"
    },
    "Releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ReleaseVersion",
          "DevIdRuleCount",
          "DevIdRules",
          "MsiDeclarativeAnalysis"
        ],
        "properties": {
          "ReleaseVersion": {
            "type": "string"
          },
          "DevIdRuleCount": {
            "type": "integer"
          },
          "DevIdRules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ProductCorrelationStatus": {
                  "enum": [
                    "MatchedInfoProduct",
                    "InfoManifestUnavailable",
                    "NoInfoProductCandidate"
                  ]
                },
                "ProductCorrelationNote": {
                  "type": "string"
                },
                "InfoProductCandidates": {
                  "type": "array"
                }
              },
              "additionalProperties": true
            }
          },
          "MsiDeclarativeAnalysis": {
            "type": [
              "object",
              "null"
            ]
          },
          "ReleaseNoteCorrelation": {
            "type": "object",
            "required": ["Status", "ReleaseVersion", "PackageComparisons", "Summary", "InterpretationBoundaries"],
            "properties": {
              "Status": {
                "enum": ["Correlated", "NotCurated", "InfoManifestUnavailable"]
              },
              "ReleaseVersion": { "type": "string" },
              "PackageComparisons": { "type": "array" },
              "Summary": { "type": "object" },
              "InterpretationBoundaries": { "type": "array" },
              "WindowsServerSupportProven": { "const": false },
              "NpuDriverPackageSelectionAuthority": { "const": false }
            },
            "additionalProperties": true
          },
          "Notes": {
            "type": "array"
          },
          "SelectorBinaryEvidence": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "Status": {
                "type": "string"
              },
              "SelectorBinaryPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "SelectorBinarySha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "StringEvidence": {
                "type": "array"
              },
              "UnicodeStringEvidence": {
                "type": "array"
              },
              "CompiledSelectorContract": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "SchemaVersion": {
                    "const": "amd-chipset-compiled-selector-contract/1.0"
                  },
                  "ContractId": {
                    "type": "string"
                  },
                  "EvidenceLevel": {
                    "const": "AmdCompiledStaticProven"
                  },
                  "Scope": {
                    "type": "object"
                  },
                  "HostOsDetection": {
                    "type": "object"
                  },
                  "InfoXmlFilter": {
                    "type": "object"
                  },
                  "FilterUsbRule": {
                    "type": "object"
                  },
                  "ReverseEngineeringNotes": {
                    "type": "array"
                  },
                  "RyzenPpkgRule": {
                    "type": "object"
                  }
                },
                "additionalProperties": true
              },
              "Notes": {
                "type": "array"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}
