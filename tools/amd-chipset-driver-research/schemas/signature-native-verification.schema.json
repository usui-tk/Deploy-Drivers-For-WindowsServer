{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amd-driver-research:signature-native-verification:1.2",
  "title": "AMD Driver Windows Native Signature Verification Evidence",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolkitVersion",
    "CollectedAtUtc",
    "EvidenceScope",
    "ExecutionContext",
    "Tool",
    "Releases",
    "MutationPerformed"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "amd-driver-signature-native-verification/1.2"
    },
    "ToolkitVersion": {
      "type": "string"
    },
    "CollectedAtUtc": {
      "type": "string"
    },
    "EvidenceScope": {
      "const": "WindowsNative"
    },
    "ReleaseSelectionPolicy": {
      "type": "string",
      "enum": [
        "OnlySelectedRelease",
        "NewestSelectedReleaseOnly"
      ]
    },
    "CandidateReleaseCount": {
      "type": "integer",
      "minimum": 1
    },
    "AnalyzedReleaseVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string"
      }
    },
    "ExecutionContext": {
      "type": "object"
    },
    "Tool": {
      "type": "object"
    },
    "Releases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "MutationPerformed": {
      "const": false
    }
  },
  "additionalProperties": true
}
