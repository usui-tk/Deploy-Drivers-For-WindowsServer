{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amd-chipset-driver-research:release-analysis:2.6",
  "title": "AMD Chipset Per-Release Semantic Analysis",
  "type": "object",
  "required": [
    "SchemaVersion",
    "ToolkitVersion",
    "Release",
    "WindowsServerProfiles",
    "Summary",
    "DriverPackages"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "amd-chipset-driver-release-analysis/2.6"
    },
    "ToolkitVersion": {
      "type": "string"
    },
    "GeneratedAtUtc": {
      "type": "string"
    },
    "AnalysisSemantics": {
      "type": "object"
    },
    "Release": {
      "type": "object",
      "properties": {
        "SignatureAnalysis": {
          "anyOf": [
            {
              "$ref": "signature-analysis.schema.json#/$defs/releaseSignatureAnalysis"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "WindowsServerProfiles": {
      "type": "array"
    },
    "Summary": {
      "type": "object"
    },
    "DriverPackages": {
      "type": "array"
    }
  }
}
